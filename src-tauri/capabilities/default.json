{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the overlay of a replay played in StarCraft II",
  "windows": [
    "main",
    "sc2-overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "opener:default",
    "dialog:default",
    "fs:default",
    "store:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "args": true,
          "name": "../assets/swarmy-bevy",
          "sidecar": true
        }
      ]
    }
  ]
}
